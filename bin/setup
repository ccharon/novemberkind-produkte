#!/usr/bin/env bash
# Startet die Testumgebung und richtet sie ein: WordPress auf Deutsch, WooCommerce,
# eine Shop-Managerin und ein paar Beispielprodukte. Mehrfach ausführbar.
set -euo pipefail
cd "$(dirname "$0")/.."

wp() { bin/wp "$@"; }

# Anthropic-SDK und weitere PHP-Abhängigkeiten (vendor/ ist nicht im Repository)
if [ ! -f vendor/autoload.php ]; then
  docker run --rm -u "$(id -u):$(id -g)" -v "$PWD":/app -w /app -e COMPOSER_HOME=/tmp composer:2 install --no-dev --no-interaction
fi

docker compose --progress quiet up -d

echo "Warte auf WordPress …"
until docker compose exec -T wordpress test -f /var/www/html/wp-config.php 2>/dev/null; do sleep 2; done

if ! wp core is-installed 2>/dev/null; then
  wp core install --url=http://localhost:8888 --title="Testshop" \
    --admin_user=admin --admin_password=password --admin_email=admin@example.org --skip-email
fi

wp language core install de_DE --activate || true
wp plugin is-installed woocommerce || wp plugin install woocommerce
wp plugin is-installed woocommerce-germanized || wp plugin install woocommerce-germanized
wp plugin activate woocommerce woocommerce-germanized novemberkind-produkte
wp language plugin install woocommerce woocommerce-germanized de_DE || true
wp rewrite structure '/%postname%/'
wp transient delete _wc_gzd_setup_wizard_redirect >/dev/null

wp option update woocommerce_currency EUR
wp option update woocommerce_default_country DE
wp option update woocommerce_price_thousand_sep .
wp option update woocommerce_price_decimal_sep ,
wp option update woocommerce_currency_pos right_space
wp option update woocommerce_dimension_unit cm
wp option update woocommerce_weight_unit kg
wp option update woocommerce_coming_soon no

wp user get shop >/dev/null 2>&1 \
  || wp user create shop shop@example.org --role=shop_manager --user_pass=password --first_name=Shop && wp user meta update shop locale de_DE

# Die Standardkategorie heißt nach der Installation „Uncategorized“
wp term update product_cat "$(wp option get default_product_cat)" --name=Unkategorisiert --slug=unkategorisiert >/dev/null

# Versandklassen und Lieferzeiten wie im echten Shop
for name in Brief Päckchen; do
  wp term list product_shipping_class --name="$name" --format=count | grep -qx 0 && wp term create product_shipping_class "$name" >/dev/null
done
for name in "1-3 Werktage" "3-5 Werktage"; do
  wp term list product_delivery_time --name="$name" --format=count | grep -qx 0 && wp term create product_delivery_time "$name" >/dev/null
done

# Versand nur nach Deutschland, Kosten je Versandklasse wie im Shop (Beträge sind Platzhalter)
wp eval '
if (WC_Shipping_Zones::get_zones() === []) {
    $zone = new WC_Shipping_Zone();
    $zone->set_zone_name("Deutschland");
    $zone->add_location("DE", "country");
    $zone->save();
    $flat = $zone->add_shipping_method("flat_rate");
    $settings = ["title" => "Versand", "tax_status" => "taxable", "cost" => "", "no_class_cost" => "1.60", "type" => "class"];
    foreach (["Brief" => "1.60", "Päckchen" => "4.50"] as $name => $cost) {
        $term = get_term_by("name", $name, "product_shipping_class");
        $term && $settings["class_cost_" . $term->term_id] = $cost;
    }
    update_option("woocommerce_flat_rate_{$flat}_settings", $settings);
}'

wp eval-file wp-content/plugins/novemberkind-produkte/bin/seed.php

echo
echo "Fertig: http://localhost:8888/wp-admin"
echo "  Admin:        admin / password"
echo "  Shop-Manager: shop  / password"
